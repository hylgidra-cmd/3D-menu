# Used by docker-compose.yml (Caddy + Postgres). Copy to .env at the repo root
# on the VPS - this is separate from backend/.env.example.

# Domain the backend API is served from, e.g. api.yourdomain.com
# Point a DNS A record at this VPS's IP before running `docker compose up`,
# so Caddy can obtain a Let's Encrypt certificate for it.
DOMAIN=

# Postgres credentials for the db container. Only reachable from inside the
# docker network (never published to the host), but still pick a real password.
POSTGRES_DB=menu3d
POSTGRES_USER=menu3d
POSTGRES_PASSWORD=
