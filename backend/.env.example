# Copy this file to .env and fill in real values. Never commit the real .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True only for local development. Must be False in production.
DEBUG=False

# Comma-separated list of domains this backend is served from.
# e.g. api.yourdomain.com
# (localhost/127.0.0.1/backend are always allowed too, for the Docker healthcheck.)
ALLOWED_HOSTS=

# Comma-separated list of frontend origins allowed to call this API
# (must NOT be "*" - required for cookie-based auth to work).
# e.g. https://menu.yourdomain.com,https://admin.yourdomain.com,https://super-admin.yourdomain.com
CORS_ALLOWED_ORIGINS=

# Postgres connection string, e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=

# 3daistudio.com API token, used to generate 3D models from menu item photos.
AISTUDIO_TOKEN=

# Base URL of the customer-facing menu app - baked into every table's QR code.
# e.g. https://menu.yourdomain.com
FRONTEND_BASE_URL=

# Cloudflare R2 (S3-compatible) storage for uploaded images - required when DEBUG=False.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# Optional: if all three are set, entrypoint.sh creates this superuser on boot
# (skipped if a user with this username already exists). Useful on hosts with
# no shell access (e.g. Render's free tier) - set these, deploy once, then
# you can blank DJANGO_SUPERUSER_PASSWORD out again.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Optional: set to True to auto-create one demo restaurant (with sample
# categories, menu items, and tables) on boot. Skipped if any restaurant
# already exists, so it's safe to leave set across redeploys.
SEED_DEMO_DATA=

# Path to the Blender executable, used to convert each normalized GLB to
# USDZ for iOS Quick Look (both live, right after a model finishes
# generating, and by `manage.py normalize_models` for existing models).
# The Docker image already sets this for you (see Dockerfile) - leave
# blank for local dev unless you have Blender installed; falls back to
# `blender` on PATH if unset. If neither is found, USDZ conversion is
# skipped and recorded as a usdz_json error - the GLB itself, and
# Android/web, are unaffected either way.
BLENDER_BINARY=
